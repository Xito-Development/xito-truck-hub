<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:padding="12dp" android:background="@drawable/notif_rest_bg">
    <ImageView android:layout_width="36dp" android:layout_height="36dp"
        android:src="@drawable/ic_stat_rest" android:tint="#FFB547" android:contentDescription="Descanso"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:layout_marginStart="12dp">
        <TextView android:id="@+id/rest_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Descanso" android:textColor="#E8EDF6" android:textSize="14sp" android:textStyle="bold"/>
        <TextView android:id="@+id/rest_sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="#8E9BB4" android:textSize="12sp"/>
    </LinearLayout>
    <Chronometer android:id="@+id/rest_chrono" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#FFB547" android:textSize="28sp" android:textStyle="bold"/>
</LinearLayout>
